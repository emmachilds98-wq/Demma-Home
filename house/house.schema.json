{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "house.schema.json",
  "title": "Demma's Home: the house file",
  "description": "Written by house/export_house.py from house/model.py and house/survey_data.py. Centimetres; x from the living room's east wall going west, y up from the living room's floor, z from its chimney breast's face to the front. A box is [x0, y0, z0, x1, y1, z1].",
  "type": "object",
  "required": ["version", "units", "floors", "rooms", "items", "measure"],
  "$defs": {
    "box": { "type": "array", "items": { "type": "number" }, "minItems": 6, "maxItems": 6 },
    "src": { "type": "string", "minLength": 1, "description": "Where the size comes from: M measured, P the plans, F/B the photos, client, fitted, E our estimate, or 'the client, in the app, <date>'" }
  },
  "properties": {
    "version": { "type": "string" },
    "units": { "const": "cm" },
    "axes": { "type": "string" },
    "floors": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "y"],
        "properties": { "id": { "enum": ["lower", "ground", "first"] }, "name": { "type": "string" }, "y": { "type": "number" } } }
    },
    "rooms": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "floor", "box", "w", "d", "ceil", "src"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "floor": { "type": "string" }, "use": { "type": "string" },
          "box": { "$ref": "#/$defs/box" }, "w": { "type": "number" }, "d": { "type": "number" }, "ceil": { "type": "number" },
          "src": { "$ref": "#/$defs/src" }, "project": { "type": ["string", "null"] },
          "pieces": { "type": "array", "description": "the room's outline as rectangles [x0, z0, x1, z1]" },
          "to_measure": { "type": "integer" }, "items": { "type": "integer" } } }
    },
    "items": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "room", "floor", "kind", "box", "src", "measure", "size"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.]+$" }, "name": { "type": "string" }, "room": { "type": "string" },
          "floor": { "type": "string" },
          "kind": { "enum": ["furniture", "door", "window", "radiator", "switch", "socket", "light", "fitting", "appliance", "decor", "finish", "fixed", "project"] },
          "box": { "$ref": "#/$defs/box" }, "src": { "$ref": "#/$defs/src" },
          "measure": { "type": "boolean", "description": "true when its size is a guess to replace" },
          "axis": { "enum": ["x", "z", null], "description": "the way its wall runs: 'along the wall' is along this axis" },
          "data": { "type": ["array", "null"], "description": "the survey_data path it's drawn from; tools/pull_edits.py writes edits back there" },
          "project": { "type": ["string", "null"] },
          "size": { "type": "object", "required": ["w", "h", "d", "up"],
            "properties": { "w": { "type": "number" }, "h": { "type": "number" }, "d": { "type": "number" }, "up": { "type": "number", "description": "up from its floor" } } },
          "opening": { "type": "object", "description": "a door's or window's hole in its wall: the viewer moves the wall's edges with it",
            "required": ["axis", "line", "a", "b", "y0", "y1"] } } }
    },
    "measure": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "room", "what", "where", "drawn", "how"],
        "properties": { "id": { "type": "string" }, "room": { "type": "string" }, "what": { "type": "string" }, "where": { "type": "string" },
          "drawn": { "type": ["number", "null"] }, "how": { "enum": ["set", "length", "agent"] }, "path": { "type": ["array", "null"] } } }
    },
    "problems": { "type": "array", "items": { "type": "string" } }
  }
}
