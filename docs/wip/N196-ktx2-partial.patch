+# N196: the photos also as KTX2 (Basis Universal UASTC, Zstandard): the graphics chip keeps them squeezed (ASTC on an iPhone, BC7 on a
+# PC), a quarter of a JPEG's memory, with no decode or upload stall. Only at build, with basisu 1.16.4 ($BASISU; the workflow builds it);
+# without it the site keeps its JPEGs alone. Bottom row first (-y_flip), as three sends the JPEGs; colour in sRGB, the rest linear.
+BASISU = ["-ktx2", "-uastc", "-uastc_level", "2", "-uastc_rdo_l", "2.0", "-ktx2_zstandard_level", "19", "-mipmap", "-y_flip"]
+CACHE = ROOT / ".ktx2cache"   # by the JPEG and the settings (the workflow keeps it between runs)
+
+
+def ktx2(jobs):
+    """[(JPEG bytes, colour?)] to [KTX2 bytes or None], side by side; all None without the encoder"""
+    exe = os.environ.get("BASISU") or shutil.which("basisu")
+    if not exe:
+        return [None] * len(jobs)
+    CACHE.mkdir(exist_ok=True)
+    def one(job):
+        args = BASISU + ([] if job[1] else ["-linear"])
+        hit = CACHE / (hashlib.sha256(job[0] + " ".join(args).encode()).hexdigest()[:16] + ".ktx2")
+        if not hit.exists():
+            with tempfile.TemporaryDirectory() as d:
+                src, dst = pathlib.Path(d) / "in.jpg", pathlib.Path(d) / "out.ktx2"
+                src.write_bytes(job[0])
+                r = subprocess.run([exe, *args, "-file", str(src), "-output_file", str(dst)], capture_output=True, text=True, cwd=d)
+                if r.returncode or not dst.exists():
+                    print("vendor: basisu failed, the JPEG alone:", (r.stdout + r.stderr)[-300:]); return None
+                shutil.move(dst, hit)
+        return hit
+    with ThreadPoolExecutor(os.cpu_count()) as ex:
+        hits = list(ex.map(one, jobs))
+    for f in CACHE.glob("*.ktx2"):
+        if f not in hits: f.unlink()
+    return [h and h.read_bytes() for h in hits]
+
+
+def transcoder(site):
+    """three's Basis transcoder beside the page (about 580 KB, fetched only by a KTX2 photo's first load): its folder's name, None
+    without it. Named by three's version, so the service worker keeps it across rounds (sw.js HASHED)"""
+    src = ROOT / "node_modules/three/examples/jsm/libs/basis"
+    if not (src / "basis_transcoder.wasm").exists():
+        return None
+    ver = json.loads((ROOT / "node_modules/three/package.json").read_text())["version"]
+    for old in site.glob("basis@*"):
+        shutil.rmtree(old)
+    shutil.copytree(src, site / f"basis@{ver}", ignore=shutil.ignore_patterns("*.md"))
+    return f"basis@{ver}/"
+
+
